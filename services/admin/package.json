{
  "name": "@elixir-drop/admin-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --sourcemap --outfile=dist/index.mjs",
    "start": "node dist/index.mjs",
    "install:launchd": "npm run build && node scripts/install-launchd.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"package.json\" \"tsconfig.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"package.json\" \"tsconfig.json\"",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware --type-check --deny-warnings .",
    "knip": "knip --no-config-hints --include files,dependencies,unlisted",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run knip && npm run test && npm run build",
    "verify:non-browser": "npm run verify"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1101.0",
    "@aws-sdk/lib-dynamodb": "^3.1101.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
