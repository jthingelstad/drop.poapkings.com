{
  "name": "elixir-drop-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "infra"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@elixir-drop/web",
    "dev:qa": "npm run dev:qa --workspace=@elixir-drop/web",
    "dev:admin": "npm run dev --workspace=@elixir-drop/admin",
    "build:admin": "npm run build --workspace=@elixir-drop/admin && npm run build --workspace=@elixir-drop/admin-service",
    "start:admin": "npm run start --workspace=@elixir-drop/admin-service",
    "install:admin": "npm run build:admin && npm run install:launchd --workspace=@elixir-drop/admin-service",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview --workspace=@elixir-drop/web",
    "theme:buttondown": "node --env-file-if-exists=.env scripts/apply-buttondown-theme.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:agent-team": "node --test scripts/agent-team.test.mjs",
    "test:ci-scope": "node --test scripts/classify-ci-scope.test.mjs",
    "test:unit": "npm run test:unit --workspace=@elixir-drop/web",
    "test:e2e": "npm run test:e2e --workspace=@elixir-drop/web --",
    "test:e2e:deploy": "npm run test:e2e:deploy --workspace=@elixir-drop/web",
    "verify": "npm run verify:non-browser && npm run test:e2e:full",
    "verify:quick": "npm run verify:non-browser && npm run test:e2e:deploy",
    "verify:non-browser": "npm run format:check && npm run lint && npm run test:agent-team && npm run test:ci-scope && npm run verify:non-browser --workspaces --if-present",
    "test:e2e:full": "npm run test:e2e --workspace=@elixir-drop/web -- --project=chromium --project=firefox --project=webkit --project=iphone-14",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"{apps,services,packages/contracts,infra,scripts}/**/*.{ts,tsx,mjs,json,yml,yaml}\" \"AGENT-TEAM/scripts/{objective-lease,season-brief,run-reports,mail-bug-reports}.mjs\" \".github/**/*.{yml,yaml}\" \"*.{json,jsonc}\"",
    "format:check": "prettier --check \"{apps,services,packages/contracts,infra,scripts}/**/*.{ts,tsx,mjs,json,yml,yaml}\" \"AGENT-TEAM/scripts/{objective-lease,season-brief,run-reports,mail-bug-reports}.mjs\" \".github/**/*.{yml,yaml}\" \"*.{json,jsonc}\"",
    "lint": "oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives .",
    "lint:css": "npm run lint:css --workspaces --if-present",
    "knip": "npm run knip --workspaces --if-present",
    "og": "npm run og --workspace=@elixir-drop/web",
    "bootstrap:aws": "npm run bootstrap --workspace=@elixir-drop/infra",
    "deploy:api": "npm run deploy --workspace=@elixir-drop/infra",
    "smoke:api": "npm run smoke --workspace=@elixir-drop/infra",
    "check:beta": "npm audit --audit-level=high && npm run verify && npm run smoke:api"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "knip": "^6.31.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6"
  }
}
