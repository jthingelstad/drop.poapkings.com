# Created with real values by: npm run bootstrap:aws
APP_URL="https://drop.poapkings.com"
AWS_ACCESS_KEY_ID=""
AWS_REGION="us-east-1"
AWS_SECRET_ACCESS_KEY=""
CR_API_KEY=""
CR_WAR_CLOCK_CLAN_TAG="#J2RGCRVG"
# Card refresh (managed, allowlisted host only — see CLAUDE.md golden rule 3).
# Always "true": the app loads card art from /cards/{id}.png, and CDN URLs break
# WebGL textures under the site CSP. A bare refresh without this reverts the
# snapshot to CDN URLs.
MIRROR_IMAGES="true"
ELIXIR_DROP_ALARM_EMAIL="elixir@poapkings.com"
# Comma-separated CORS origins for the HTTP API. Leave empty to keep whatever is
# already deployed — infra/scripts/parameters.mjs preserves it rather than
# resetting it to the template Default on every deploy.
ELIXIR_DROP_ALLOWED_ORIGINS=""
ELIXIR_DROP_CFN_ROLE_ARN=""
ELIXIR_DROP_CODE_BUCKET=""
ELIXIR_DROP_CR_BRIDGE_AWS_ACCESS_KEY_ID=""
ELIXIR_DROP_CR_BRIDGE_AWS_SECRET_ACCESS_KEY=""
ELIXIR_DROP_CR_REQUEST_QUEUE_NAME="elixir-drop-cr-requests"
ELIXIR_DROP_CR_RESULT_QUEUE_NAME="elixir-drop-cr-results"
ELIXIR_DROP_EMAIL_FROM="elixir@poapkings.com"
ELIXIR_DROP_DISCORD_WEBHOOK_URL=""
ELIXIR_DROP_STACK_NAME="elixir-drop-prod"
FASTMAIL_JMAP_TOKEN=""
BUTTONDOWN_API_KEY=""
BUTTONDOWN_NEWSLETTER_ID=""
NAME_MODEL_ID="us.anthropic.claude-haiku-4-5-20251001-v1:0"
SESSION_SECRET=""
TELEMETRY_PEPPER=""
